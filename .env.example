# Copy to .env (never commit .env) and adjust as needed.
# PostgreSQL connection for the generator loader and dbt.
DATABASE_URL=postgresql://warehouse_loader:warehouse_loader@localhost:5432/warehouse
POSTGRES_USER=warehouse_admin
POSTGRES_PASSWORD=warehouse_admin
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# dbt
DBT_USER=warehouse_transformer
DBT_PASSWORD=warehouse_transformer
DBT_DBNAME=warehouse
DBT_SCHEMA=staging

# Metabase container
METABASE_PORT=3000
